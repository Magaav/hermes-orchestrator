[Unit]
Description=Visao Vendas MVP PWA
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/local/projects/visao
ExecStart=/local/projects/visao/scripts/start.sh
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
BindReadOnlyPaths=/home/ubuntu/.vscode-server/extensions:/run/visao-vscode-extensions
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/local/projects/visao/data
Environment="HOME=/local/projects/visao/data/studio-runtime/home"
Environment="USER=ubuntu"
Environment="LOGNAME=ubuntu"
Environment="STUDIO_RUNTIME_ROOT=/local/projects/visao/data/studio-runtime"
Environment="CODEX_HOME=/local/projects/visao/data/studio-runtime/codex-home"
Environment="STUDIO_CODEX_SEARCH_ROOT=/run/visao-vscode-extensions"
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
