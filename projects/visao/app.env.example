APP_NAME="Visão Vendas"
APP_ENV="production"
APP_TIMEZONE="America/Sao_Paulo"
APP_PUBLIC_BASE_URL="https://visao.colmeio.com"
HTTP_BIND="127.0.0.1"
HTTP_PORT="18083"
PROJECT_ROOT="/local/projects/visao"
DB_PATH="/local/projects/visao/data/visao.sqlite3"
UPLOADS_DIR="/local/projects/visao/data/uploads"
FRONTEND_DIST="/local/projects/visao/frontend/dist"
STUDIO_PYTHON_BIN="python3"
STUDIO_WORKER_SCRIPT="/local/projects/visao/backend/studio_worker.py"
STUDIO_CODEX_SCRIPT="/local/projects/visao/backend/studio_codex.py"
STUDIO_SESSIONS_DIR="/local/projects/visao/data/studio-sessions"
GOOGLE_CREDENTIALS_FILE="/local/projects/zaiaecainelli/app.env"
GOOGLE_REDIRECT_URL="https://visao.colmeio.com/auth/google/callback"
AUTH_ALLOWED_EMAILS="authorized.user@example.com"
AUTH_ALLOW_ALL_GOOGLE_EMAILS="false"
SESSION_SECRET="replace-with-at-least-32-random-characters"
SECURE_COOKIES="true"
