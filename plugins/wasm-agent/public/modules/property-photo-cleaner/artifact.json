  "type": "space-widget",
  "version": "0.2.0",
  "displayName": "Property Photo Cleaner",
  "description": "Browser-local object detection with explicit-consent, high-quality cloud AI cleanup.",
  "entry": "./property-photo-cleaner.entry.js",
  "icon": "./icon.svg",
